# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Must match workflows/n8n/.env XASS_WORKER_SECRET.
XASS_WORKER_SECRET=replace-with-worker-secret

# LLM provider. Use "ollama_cloud" for Ollama Cloud API deployment,
# "ollama" for local/offline demos, or "openai-compatible" for another
# compatible endpoint. Falls back to rule-based extraction when unavailable.
XASS_LLM_PROVIDER=ollama_cloud

# Ollama Cloud direct API.
OLLAMA_CLOUD_BASE_URL=https://ollama.com/api
OLLAMA_API_KEY=your-ollama-api-key
OLLAMA_CLOUD_MODEL=gpt-oss:20b

# Optional local Ollama settings if XASS_LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional generic OpenAI-compatible endpoint if XASS_LLM_PROVIDER=openai-compatible.
XASS_CLOUD_LLM_BASE_URL=https://ollama.com/v1
XASS_CLOUD_LLM_API_KEY=your-compatible-api-key
XASS_CLOUD_LLM_MODEL=gpt-oss:20b

