{
  "name": "X-Assurance - Supabase Document Polling",
  "nodes": [
    {
      "parameters": {
        "content": "## Supabase job polling\nRuns every 60 seconds. The atomic database claim returns at most one queued parse_document job per poll and caps active jobs at two.\n\nRequired env: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, XASS_DOCUMENT_WORKER_URL, XASS_WORKER_SECRET.",
        "height": 260,
        "width": 380
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -720,
        -260
      ],
      "id": "9c7ce445-2db5-4a25-8fdf-08b76db8c001",
      "name": "Setup Note"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first()?.json;\nif (!input) return [];\nconst rows = Array.isArray(input) ? input : Array.isArray(input.body) ? input.body : input.id ? [input] : [];\nreturn rows.filter((record) => record?.status === 'processing' && record.job_type === 'parse_document').map((record) => ({ json: { job_id: record.id, project_id: record.project_id, document_id: record.document_id, job_type: record.job_type, status: record.status, metadata: record.metadata ?? {}, valid: Boolean(record.id && record.project_id && record.document_id) } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        80
      ],
      "id": "9ddc10ab-d8b4-49f9-b901-9cf30f7e4c22",
