    },
    {
      "parameters": {
        "content": "Worker response contract\n\nThe worker should download the PDF from Supabase Storage with a service role key, parse it, run extraction/AI, and return JSON:\n\nchunks[]\nfacts[]\nsummary\nhealth_snapshots[]\nalerts[]\nactions[]\n\nn8n writes the returned rows to Supabase.",
        "height": 300,
        "width": 430
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        900,
        180
      ],
      "id": "d9e9c681-d4f0-4495-b94f-0b6e58e75552",
      "name": "Worker Contract Note"
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst { project_id, document_id, job_id, document } = $node['Build Worker Request'].json;\nconst chunks = (result.chunks ?? []).map((chunk, index) => ({ project_id, document_id, chunk_index: Number.isInteger(chunk.chunk_index) ? chunk.chunk_index : index, chunk_text: String(chunk.chunk_text ?? chunk.text ?? '').trim(), page_number: chunk.page_number ?? null, section_label: chunk.section_label ?? null, parser_metadata: chunk.parser_metadata ?? { source: 'document_worker' } })).filter((chunk) => chunk.chunk_text.length > 0);\nconst facts = (result.facts ?? []).map((fact, fact_index) => ({ fact_index, project_id, fact_type: fact.fact_type, extracted_text: String(fact.extracted_text ?? fact.text ?? '').trim(), original_value: String(fact.original_value ?? fact.extracted_text ?? fact.text ?? '').trim(), confidence: Math.max(0, Math.min(1, Number(fact.confidence))), confirmation_state: 'ai_extracted', evidence_excerpt: fact.excerpt ?? fact.evidence_excerpt, evidence_chunk_index: fact.evidence_chunk_index }));\nconst summary = result.summary?.summary_text ? { project_id, summary_text: String(result.summary.summary_text), confidence: Number(result.summary.confidence), quality_warning: result.summary.quality_warning ?? null, selected_document_ids: [document_id], metadata: { generated_by: 'n8n_document_worker', job_id, document_title: document.title, evidence_count: chunks.length } } : null;\nconst dimensions = ['overall', 'schedule', 'cost', 'risk', 'governance', 'audit_readiness'];\nconst health_snapshots = (result.health_snapshots ?? []).map((snapshot) => ({ project_id, dimension: snapshot.dimension, score: snapshot.score ?? null, status: snapshot.status, evidence_coverage: snapshot.evidence_coverage ?? null, status_text: snapshot.status_text, snapshot_date: snapshot.snapshot_date, source_summary: snapshot.source_summary })).filter((snapshot) => dimensions.includes(snapshot.dimension) && snapshot.snapshot_date && snapshot.source_summary);\nconst alerts = (result.alerts ?? []).map((alert) => ({ project_id, severity: alert.severity, impacted_area: String(alert.impacted_area ?? alert.area ?? ''), explanation: String(alert.explanation ?? alert.title ?? ''), evidence_count: Number(alert.evidence_count ?? 1), recommended_action: String(alert.recommended_action ?? ''), source_path: alert.source_path ?? `/app/projects/${project_id}/documents?document=${document_id}` })).filter((alert) => ['low', 'medium', 'high', 'critical'].includes(alert.severity) && alert.explanation.length > 0);\nconst actions = (result.actions ?? result.recommended_actions ?? []).map((action) => ({ project_id, title: String(action.title ?? action.action ?? '').trim(), owner_name: action.owner_name ?? action.owner_or_function ?? null, due_date: action.due_date ?? null, priority: action.priority, status: action.status ?? 'open', source_path: action.source_path ?? `/app/projects/${project_id}/anomalies` })).filter((action) => ['low', 'medium', 'high'].includes(action.priority) && action.title.length > 0);\nconst anomalies = (result.anomalies ?? []).map((anomaly) => ({ project_id, category: anomaly.category, missing_field: anomaly.missing_field ?? null, severity: anomaly.severity, status: anomaly.status ?? 'open', title: String(anomaly.title ?? '').trim(), affected_item: String(anomaly.affected_item ?? anomaly.affectedItem ?? '').trim(), explanation: String(anomaly.explanation ?? '').trim(), impact: String(anomaly.impact ?? '').trim(), impact_rating: String(anomaly.impact_rating ?? anomaly.impactRating ?? '').trim(), recommended_action: String(anomaly.recommended_action ?? anomaly.recommendedAction ?? '').trim(), suggested_owners: Array.isArray(anomaly.suggested_owners) ? anomaly.suggested_owners : [], evidence_count: Number(anomaly.evidence_count ?? 1), absence_type: anomaly.absence_type, rationale: String(anomaly.rationale ?? '').trim(), source_path: anomaly.source_path ?? `/app/projects/${project_id}/documents?document=${document_id}` })).filter((anomaly) => ['cost', 'schedule', 'risk', 'governance', 'scope', 'accountability'].includes(anomaly.category) && ['low', 'medium', 'high', 'critical'].includes(anomaly.severity) && ['not_found_in_evidence', 'confirmed_missing', 'not_applicable'].includes(anomaly.absence_type) && anomaly.title.length > 0 && anomaly.affected_item.length > 0 && anomaly.explanation.length > 0);\nreturn [{ json: { project_id, document_id, job_id, document, processing_status: result.processing_status, processing_error: result.processing_error ?? null, chunks, facts, summary, summary_sources: (result.summary_sources ?? []).map((source) => ({ project_id, document_id, evidence_chunk_index: source.evidence_chunk_index, excerpt: source.excerpt, confidence: source.confidence })), health_snapshots, alerts, actions, anomalies, extraction_run: { project_id, document_id, ai_job_id: job_id, status: 'processing', metadata: { source: 'n8n_document_processing', worker: result.worker ?? 'external', chunk_count: chunks.length, fact_count: facts.length } } } }];"
      },
