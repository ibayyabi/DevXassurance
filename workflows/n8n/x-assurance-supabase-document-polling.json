{
  "name": "X-Assurance - Supabase Document Polling",
  "nodes": [
    {
      "parameters": {
        "content": "## Supabase job polling\nRuns every 15 seconds and processes the oldest queued parse_document job.\n\nRequired env: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, XASS_DOCUMENT_WORKER_URL, XASS_WORKER_SECRET.",
        "height": 260,
        "width": 380
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -720,
        -260
      ],
      "id": "9c7ce445-2db5-4a25-8fdf-08b76db8c001",
      "name": "Setup Note"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first()?.json;\nif (!input) return [];\n\nconst rows = Array.isArray(input)\n  ? input\n  : Array.isArray(input.body)\n    ? input.body\n    : input.id\n      ? [input]\n      : [];\n\nconst record = rows[0];\nif (!record) return [];\n\nreturn [{\n  json: {\n    job_id: record.id,\n    project_id: record.project_id,\n    document_id: record.document_id,\n    job_type: record.job_type,\n    status: record.status,\n    metadata: record.metadata ?? {},\n    valid: Boolean(\n      record.id &&\n      record.project_id &&\n      record.document_id &&\n      record.job_type === 'parse_document' &&\n      record.status === 'queued'\n    )\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        80
      ],
      "id": "9ddc10ab-d8b4-49f9-b901-9cf30f7e4c22",
