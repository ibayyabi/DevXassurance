        "url": "={{ $env.SUPABASE_URL + '/rest/v1/documents?id=eq.' + $node['Normalize Job Payload'].json.document_id + '&select=id,project_id,title,file_name,file_size,mime_type,document_type,storage_bucket,storage_path,document_date,created_at' }}",
        "sendHeaders": true,
        "headerParameters": {
