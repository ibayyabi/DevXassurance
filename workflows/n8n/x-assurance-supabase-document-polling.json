    },
    {
      "parameters": {
        "jsCode": "const rawRun = $input.first().json;\nconst run = Array.isArray(rawRun) ? rawRun[0] : rawRun;\nconst rows = $items('Build Supabase Rows')[0].json;\n\nreturn [\n  {\n    json: {\n      facts: rows.facts.map(({ evidence_excerpt, evidence_chunk_index, fact_index, ...fact }) => ({\n        ...fact,\n        extraction_run_id: run.id\n      })),\n      fact_evidence: rows.facts.map((fact) => ({\n        fact_index: fact.fact_index,\n        evidence_excerpt: fact.evidence_excerpt,\n        evidence_chunk_index: fact.evidence_chunk_index\n      }))\n    }\n  }\n];"
      },
