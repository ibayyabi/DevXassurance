      "id": "2f0b3d29-20fb-448f-bb3a-8703f90b4e99",
      "name": "Call Document Worker"
    },
    {
      "parameters": {
        "content": "Worker response contract\n\nThe worker should download the PDF from Supabase Storage with a service role key, parse it, run extraction/AI, and return JSON:\n\nchunks[]\nfacts[]\nsummary\nhealth_snapshots[]\nalerts[]\nactions[]\n\nn8n writes the returned rows to Supabase.",
        "height": 300,
        "width": 430
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        900,
        180
      ],
      "id": "d9e9c681-d4f0-4495-b94f-0b6e58e75552",
      "name": "Worker Contract Note"
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst requestContext = $node['Build Worker Request'].json;\nconst { project_id, document_id, job_id, document } = requestContext;\n\nconst chunks = (result.chunks ?? []).map((chunk, index) => ({\n  project_id,\n  document_id,\n  chunk_index: Number.isInteger(chunk.chunk_index) ? chunk.chunk_index : index,\n  chunk_text: String(chunk.chunk_text ?? chunk.text ?? '').trim(),\n  page_number: chunk.page_number ?? null,\n  section_label: chunk.section_label ?? null,\n  parser_metadata: chunk.parser_metadata ?? { source: 'document_worker' }\n})).filter((chunk) => chunk.chunk_text.length > 0);\n\nconst facts = (result.facts ?? []).map((fact, index) => ({\n  fact_index: index,\n  project_id,\n  fact_type: fact.fact_type,\n  extracted_text: String(fact.extracted_text ?? fact.text ?? '').trim(),\n  original_value: String(fact.original_value ?? fact.extracted_text ?? fact.text ?? '').trim(),\n  confidence: Math.max(0, Math.min(1, Number(fact.confidence ?? 0.65))),\n  confirmation_state: 'ai_extracted',\n  evidence_excerpt: fact.excerpt ?? fact.evidence_excerpt ?? null,\n  evidence_chunk_index: Number.isInteger(fact.evidence_chunk_index) ? fact.evidence_chunk_index : null\n})).filter((fact) => ['risk', 'issue', 'milestone', 'decision', 'owner_action'].includes(fact.fact_type) && fact.extracted_text.length > 0);\n\nconst summary = result.summary?.summary_text ? {\n  project_id,\n  summary_text: String(result.summary.summary_text),\n  confidence: Math.max(0, Math.min(1, Number(result.summary.confidence ?? 0.65))),\n  quality_warning: result.summary.quality_warning ?? null,\n  selected_document_ids: [document_id],\n  metadata: {\n    generated_by: 'n8n_document_worker',\n    job_id,\n    document_title: document.title,\n    evidence_count: chunks.length\n  }\n} : null;\n\nconst healthSnapshots = (result.health_snapshots ?? []).map((snapshot) => ({\n  project_id,\n  dimension: snapshot.dimension,\n  score: snapshot.score ?? null,\n  status: snapshot.status ?? 'insufficient_evidence',\n  evidence_coverage: snapshot.evidence_coverage ?? null,\n  status_text: String(snapshot.status_text ?? snapshot.status ?? 'Insufficient evidence'),\n  snapshot_date: snapshot.snapshot_date ?? document.document_date ?? document.created_at?.slice(0, 10) ?? new Date().toISOString().slice(0, 10),\n  source_summary: snapshot.source_summary ?? document.title\n})).filter((snapshot) => ['overall', 'schedule', 'cost', 'risk', 'governance', 'audit_readiness'].includes(snapshot.dimension));\n\nconst alerts = (result.alerts ?? []).map((alert) => ({\n  project_id,\n  severity: alert.severity ?? 'medium',\n  impacted_area: String(alert.impacted_area ?? alert.area ?? 'Document intelligence'),\n  explanation: String(alert.explanation ?? alert.title ?? ''),\n  evidence_count: Number(alert.evidence_count ?? 1),\n  recommended_action: String(alert.recommended_action ?? 'Review the source document and assign an owner.'),\n  source_path: alert.source_path ?? `/app/projects/${project_id}/documents?document=${document_id}`\n})).filter((alert) => ['low', 'medium', 'high', 'critical'].includes(alert.severity) && alert.explanation.length > 0);\n\nconst actions = (result.actions ?? result.recommended_actions ?? []).map((action) => ({\n  project_id,\n  title: String(action.title ?? action.action ?? '').trim(),\n  owner_name: action.owner_name ?? action.owner_or_function ?? null,\n  due_date: action.due_date ?? null,\n  priority: action.priority ?? 'medium',\n  status: action.status ?? 'open',\n  source_path: action.source_path ?? `/app/projects/${project_id}/anomalies`\n})).filter((action) => ['low', 'medium', 'high'].includes(action.priority) && action.title.length > 0);\n\nconst anomalies = (result.anomalies ?? []).map((anomaly) => ({\n  project_id,\n  category: anomaly.category ?? 'risk',\n  missing_field: anomaly.missing_field ?? null,\n  severity: anomaly.severity ?? 'medium',\n  status: anomaly.status ?? 'open',\n  title: String(anomaly.title ?? '').trim(),\n  affected_item: String(anomaly.affected_item ?? anomaly.affectedItem ?? document.title ?? '').trim(),\n  explanation: String(anomaly.explanation ?? '').trim(),\n  impact: String(anomaly.impact ?? 'Evidence requires project assurance review.').trim(),\n  impact_rating: String(anomaly.impact_rating ?? anomaly.impactRating ?? 'Medium').trim(),\n  recommended_action: String(anomaly.recommended_action ?? anomaly.recommendedAction ?? 'Review the source evidence and assign an owner.').trim(),\n  suggested_owners: Array.isArray(anomaly.suggested_owners) ? anomaly.suggested_owners : [],\n  evidence_count: Number(anomaly.evidence_count ?? 1),\n  absence_type: anomaly.absence_type ?? 'not_applicable',\n  rationale: String(anomaly.rationale ?? 'Generated from document processing output.').trim(),\n  source_path: anomaly.source_path ?? `/app/projects/${project_id}/documents?document=${document_id}`\n})).filter((anomaly) =>\n  ['cost', 'schedule', 'risk', 'governance', 'scope', 'accountability'].includes(anomaly.category) &&\n  ['low', 'medium', 'high', 'critical'].includes(anomaly.severity) &&\n  ['not_found_in_evidence', 'confirmed_missing', 'not_applicable'].includes(anomaly.absence_type) &&\n  anomaly.title.length > 0 &&\n  anomaly.affected_item.length > 0 &&\n  anomaly.explanation.length > 0\n);\n\nreturn [\n  {\n    json: {\n      project_id,\n      document_id,\n      job_id,\n      document,\n      chunks,\n      extraction_run: {\n        project_id,\n        document_id,\n        ai_job_id: job_id,\n        status: 'processing',\n        metadata: {\n          source: 'n8n_document_processing',\n          worker: result.worker ?? 'external',\n          chunk_count: chunks.length,\n          fact_count: facts.length\n        }\n      },\n      facts,\n      summary,\n      summary_sources: summary ? chunks.slice(0, 5).map((chunk) => ({\n        project_id,\n        document_id,\n        excerpt: chunk.chunk_text.slice(0, 280),\n        confidence: summary.confidence\n      })) : [],\n      health_snapshots: healthSnapshots,\n      alerts,\n      actions,\n      anomalies\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        -40
      ],
      "id": "5ec2b1f8-f5e9-4d15-bd3b-b238d67cf7ad",
