      "id": "02cf216e-0abe-463e-962e-2489e76b16db",
      "name": "Insert Document Summary"
    },
    {
      "parameters": {
        "jsCode": "const rawSummary = $input.first().json;\nconst summary = Array.isArray(rawSummary) ? rawSummary[0] : rawSummary;\nconst rows = $items('Build Supabase Rows')[0].json;\nconst chunks = $items('Upsert Document Chunks').map(item => item.json);\n\nif (!summary?.id) {\n  return [{ json: { sources: [] } }];\n}\n\nconst sources = rows.summary_sources.map((source, index) => ({\n  project_id: rows.project_id,\n  summary_id: summary.id,\n  document_id: rows.document_id,\n  document_chunk_id: chunks[index]?.id ?? null,\n  excerpt: source.excerpt,\n  confidence: source.confidence\n}));\n\nreturn [{ json: { sources } }];"
      },
