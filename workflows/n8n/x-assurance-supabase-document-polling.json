    },
    {
      "parameters": {
        "jsCode": "const rawSummary = $input.first().json;\nconst summary = Array.isArray(rawSummary) ? rawSummary[0] : rawSummary;\nconst rows = $items('Build Supabase Rows')[0].json;\nconst chunks = $items('Get Persisted Document Chunks').map(item => item.json);\n\nif (!summary?.id) {\n  return [{ json: { sources: [] } }];\n}\n\nconst sources = rows.summary_sources.map((source) => {\n  const chunk = chunks.find((candidate) => candidate.chunk_index === source.evidence_chunk_index);\n  if (!chunk?.id) throw new Error('Validated summary source chunk was not returned by storage.');\n  return {\n    project_id: rows.project_id,\n    summary_id: summary.id,\n    document_id: rows.document_id,\n    document_chunk_id: chunk.id,\n    excerpt: source.excerpt,\n    confidence: source.confidence\n  };\n});\n\nreturn [{ json: { sources } }];"
