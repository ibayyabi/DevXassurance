        "url": "={{ $env.SUPABASE_URL + '/rest/v1/extraction_runs' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $items('Build Supabase Rows')[0].json.extraction_run }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1720,
        -40
      ],
      "id": "611f8f10-fc9c-4e38-9274-aab3b4c178ad",
      "name": "Create Extraction Run"
    },
    {
      "parameters": {
        "jsCode": "const rawRun = $input.first().json;\nconst run = Array.isArray(rawRun) ? rawRun[0] : rawRun;\nconst rows = $items('Build Supabase Rows')[0].json;\n\nreturn [\n  {\n    json: {\n      facts: rows.facts.map(({ evidence_excerpt, evidence_chunk_index, fact_index, ...fact }) => ({\n        ...fact,\n        extraction_run_id: run.id\n      })),\n      fact_evidence: rows.facts.map((fact) => ({\n        fact_index: fact.fact_index,\n        evidence_excerpt: fact.evidence_excerpt,\n        evidence_chunk_index: fact.evidence_chunk_index\n      }))\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1960,
        -40
      ],
      "id": "8cded7bf-7ec1-46b8-a4b8-e370238e3c6b",
      "name": "Build Fact Inserts"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/extracted_facts' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.facts }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2200,
        -40
      ],
      "id": "6fbec9b1-df2f-4f16-a7f8-53ce66e00e1f",
      "name": "Insert Extracted Facts"
    },
    {
      "parameters": {
        "jsCode": "const insertedFacts = $input.all().map((item) => item.json);\nconst rows = $items('Build Supabase Rows')[0].json;\nconst chunks = $items('Upsert Document Chunks').map(item => item.json);\nconst factEvidence = $items('Build Fact Inserts')[0].json.fact_evidence ?? [];\n\nconst links = insertedFacts.map((fact, index) => {\n  const evidence = factEvidence[index] ?? {};\n  const chunk = Number.isInteger(evidence.evidence_chunk_index)\n    ? chunks.find((candidate) => candidate.chunk_index === evidence.evidence_chunk_index)\n    : null;\n\n  return {\n    project_id: rows.project_id,\n    extracted_fact_id: fact.id,\n    document_id: rows.document_id,\n    document_chunk_id: chunk?.id ?? null,\n    excerpt: evidence.evidence_excerpt ?? chunk?.chunk_text?.slice(0, 280) ?? null,\n    confidence: fact.confidence ?? 0.65\n  };\n});\n\nreturn [{ json: { links } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2440,
        -40
      ],
      "id": "bd70e21d-48c4-4a64-aaf8-22048ce19a1b",
