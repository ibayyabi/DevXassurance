        2200,
        -40
      ],
      "id": "6fbec9b1-df2f-4f16-a7f8-53ce66e00e1f",
      "name": "Insert Extracted Facts"
    },
    {
      "parameters": {
        "jsCode": "const insertedFacts = $input.all().map((item) => item.json);\nconst rows = $items('Build Supabase Rows')[0].json;\nconst chunks = $items('Get Persisted Document Chunks').map(item => item.json);\nconst factEvidence = $items('Build Fact Inserts')[0].json.fact_evidence ?? [];\n\nconst links = insertedFacts.map((fact, index) => {\n  const evidence = factEvidence[index];\n  const chunk = Number.isInteger(evidence?.evidence_chunk_index)\n    ? chunks.find((candidate) => candidate.chunk_index === evidence.evidence_chunk_index)\n    : null;\n  const confidence = fact.confidence;\n  if (\n    !chunk?.id ||\n    typeof evidence?.evidence_excerpt !== 'string' ||\n    !evidence.evidence_excerpt ||\n    typeof chunk.chunk_text !== 'string' ||\n    !chunk.chunk_text.includes(evidence.evidence_excerpt) ||\n    typeof confidence !== 'number' ||\n    !Number.isFinite(confidence) ||\n    confidence < 0 ||\n    confidence > 1\n  ) {\n    throw new Error('No verified source citation or valid confidence for an extracted fact.');\n  }\n\n  return {\n    project_id: rows.project_id,\n    extracted_fact_id: fact.id,\n    document_id: rows.document_id,\n    document_chunk_id: chunk.id,\n    excerpt: evidence.evidence_excerpt,\n    confidence\n  };\n});\n\nreturn [{ json: { links } }];"
      },
