# =========================
# PostgreSQL for n8n internal data
# =========================
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=n8n

# =========================
# n8n Basic Config
# =========================
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Local HTTP only; use true when n8n is served over HTTPS.
N8N_SECURE_COOKIE=false

# =========================
# Security
# Generate your own value and keep it stable for this n8n instance.
# =========================
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string

# =========================
# Timezone
# =========================
GENERIC_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta

# =========================
# Privacy / telemetry
# =========================
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false

# =========================
# File access
# =========================
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
N8N_RESTRICT_FILE_ACCESS_TO=/files

# Required because the workflow Code nodes read $env.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# =========================
# X-Assurance Supabase + worker integration
# =========================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# n8n runs in Docker, so host.docker.internal reaches the Next.js server
# running on the host at localhost:3000.
XASS_DOCUMENT_WORKER_URL=http://host.docker.internal:3000/api/workers/parse-document

# Use one shared secret value here and in Supabase webhook headers.
XASS_N8N_WEBHOOK_SECRET=replace-with-shared-webhook-secret

# Use this same value in the root app .env.local as XASS_WORKER_SECRET.
XASS_WORKER_SECRET=replace-with-worker-secret
