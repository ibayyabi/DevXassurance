    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst document = Array.isArray(raw) ? raw[0] : raw;\nconst job = $node['Normalize Job Payload'].json;\n\nif (!document?.id) {\n  throw new Error('Document row was not found for queued AI job.');\n}\n\nreturn [\n  {\n    json: {\n      job_id: job.job_id,\n      project_id: job.project_id,\n      document_id: job.document_id,\n      document,\n      worker_request: {\n        job_id: job.job_id,\n        project_id: job.project_id,\n        document_id: job.document_id,\n        storage_bucket: document.storage_bucket || 'project-evidence',\n        storage_path: document.storage_path,\n        title: document.title,\n        file_name: document.file_name,\n        document_type: document.document_type,\n        document_date: document.document_date\n      }\n    }\n  }\n];"
