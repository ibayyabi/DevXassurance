      "id": "611f8f10-fc9c-4e38-9274-aab3b4c178ad",
      "name": "Create Extraction Run"
    },
    {
      "parameters": {
        "jsCode": "const rows = $items('Build Supabase Rows')[0].json;\nconst rawRun = $input.first().json;\nconst run = Array.isArray(rawRun) ? rawRun[0] : rawRun;\nif (!run?.id) throw new Error('The document extraction run was not created.');\nreturn [{\n  json: {\n    facts: rows.facts.map((fact) => ({ ...fact, extraction_run_id: run.id })),\n    fact_evidence: rows.fact_evidence\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1960,
        -40
      ],
      "id": "8cded7bf-7ec1-46b8-a4b8-e370238e3c6b",
      "name": "Build Fact Inserts"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/extracted_facts' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.facts }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2200,
        -40
      ],
      "id": "6fbec9b1-df2f-4f16-a7f8-53ce66e00e1f",
      "name": "Insert Extracted Facts"
    },
    {
      "parameters": {
        "jsCode": "const insertedFacts = $input.all().map((item) => item.json);\nconst rows = $items('Build Supabase Rows')[0].json;\nconst chunks = $items('Upsert Document Chunks').map((item) => item.json);\nconst factEvidence = $items('Build Fact Inserts')[0].json.fact_evidence;\nif (!Array.isArray(factEvidence) || insertedFacts.length !== factEvidence.length) {\n  throw new Error('The extracted facts have no complete verified source citations.');\n}\nconst links = insertedFacts.map((fact, index) => {\n  const evidence = factEvidence[index];\n  const chunk = Number.isInteger(evidence?.evidence_chunk_index)\n    ? chunks.find((candidate) => candidate.chunk_index === evidence.evidence_chunk_index)\n    : null;\n  if (!fact.id || !chunk?.id || typeof evidence?.evidence_excerpt !== 'string' || !evidence.evidence_excerpt || !chunk.chunk_text.includes(evidence.evidence_excerpt) || typeof fact.confidence !== 'number' || !Number.isFinite(fact.confidence) || fact.confidence < 0 || fact.confidence > 1) {\n    throw new Error('The extracted fact has no verified source citation or valid confidence.');\n  }\n  return {\n    project_id: rows.project_id,\n    extracted_fact_id: fact.id,\n    document_id: rows.document_id,\n    document_chunk_id: chunk.id,\n    excerpt: evidence.evidence_excerpt,\n    confidence: fact.confidence\n  };\n});\nreturn [{ json: { links } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
