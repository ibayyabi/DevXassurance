    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body ?? input;\nconst headers = input.headers ?? {};\nconst expectedSecret = $env.XASS_N8N_WEBHOOK_SECRET;\n\nif (expectedSecret) {\n  const provided = headers['x-xass-workflow-secret'] ?? headers['X-Xass-Workflow-Secret'];\n  if (provided !== expectedSecret) {\n    throw new Error('Invalid X-Assurance workflow secret.');\n  }\n}\n\nconst record = body.record ?? body.new ?? body;\n\nreturn [\n  {\n    json: {\n      job_id: record.id,\n      project_id: record.project_id,\n      document_id: record.document_id,\n      job_type: record.job_type,\n      status: record.status,\n      metadata: record.metadata ?? {},\n      valid: Boolean(record.id && record.project_id && record.document_id && record.job_type === 'parse_document' && record.status === 'queued')\n    }\n  }\n];"
      },
