    },
    {
      "parameters": {
        "content": "Worker response contract\n\nThe worker should download the PDF from Supabase Storage with a service role key, parse it, run extraction/AI, and return JSON:\n\nchunks[]\nfacts[]\nsummary\nhealth_snapshots[]\nalerts[]\nactions[]\n\nn8n writes the returned rows to Supabase.",
        "height": 300,
        "width": 430
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        900,
        180
      ],
      "id": "d9e9c681-d4f0-4495-b94f-0b6e58e75552",
      "name": "Worker Contract Note"
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst context = $node['Build Worker Request'].json;\nconst { project_id, document_id, job_id, document } = context;\n\nconst chunks = (result.chunks ?? []).map((chunk, index) => ({\n  project_id,\n  document_id,\n  chunk_index: Number.isInteger(chunk.chunk_index) ? chunk.chunk_index : index,\n  chunk_text: String(chunk.chunk_text ?? chunk.text ?? '').trim(),\n  page_number: chunk.page_number ?? null,\n  section_label: chunk.section_label ?? null,\n  parser_metadata: chunk.parser_metadata ?? { source: 'document_worker' }\n}));\nconst chunksByIndex = new Map(chunks.map((chunk) => [chunk.chunk_index, chunk]));\nconst requireSource = (index, excerpt, label) => {\n  const chunk = chunksByIndex.get(index);\n  if (!chunk || typeof excerpt !== 'string' || !excerpt || !chunk.chunk_text.includes(excerpt)) {\n    throw new Error('The document worker returned an invalid ' + label + ' citation.');\n  }\n  return chunk;\n};\nconst factEvidence = [];\nconst facts = (result.facts ?? []).map((fact) => {\n  requireSource(fact.evidence_chunk_index, fact.excerpt, 'fact');\n  if (typeof fact.confidence !== 'number' || !Number.isFinite(fact.confidence) || fact.confidence < 0 || fact.confidence > 1) {\n    throw new Error('The document worker returned invalid fact confidence.');\n  }\n  if (!['risk', 'issue', 'milestone', 'decision', 'owner_action'].includes(fact.fact_type) || typeof fact.extracted_text !== 'string' || !fact.extracted_text.trim() || typeof fact.original_value !== 'string') {\n    throw new Error('The document worker returned an invalid fact.');\n  }\n  factEvidence.push({ evidence_chunk_index: fact.evidence_chunk_index, evidence_excerpt: fact.excerpt });\n  return {\n    project_id,\n    fact_type: fact.fact_type,\n    extracted_text: fact.extracted_text.trim(),\n    original_value: fact.original_value.trim(),\n    confidence: fact.confidence,\n    confirmation_state: 'ai_extracted'\n  };\n});\n\nif (typeof result.summary?.summary_text !== 'string' || !result.summary.summary_text.trim() || typeof result.summary.confidence !== 'number' || !Number.isFinite(result.summary.confidence) || result.summary.confidence < 0 || result.summary.confidence > 1) {\n  throw new Error('The document worker returned an invalid summary.');\n}\nconst verifiedSummarySources = result.summary_sources ?? [];\nif (!verifiedSummarySources.length) throw new Error('The document summary has no verified source citations.');\nfor (const source of verifiedSummarySources) {\n  requireSource(source.evidence_chunk_index, source.excerpt, 'summary');\n  if (typeof source.confidence !== 'number' || !Number.isFinite(source.confidence) || source.confidence < 0 || source.confidence > 1) {\n    throw new Error('The document worker returned invalid summary confidence.');\n  }\n}\nconst summary = {\n  project_id,\n  summary_text: result.summary.summary_text.trim(),\n  confidence: result.summary.confidence,\n  quality_warning: result.summary.quality_warning ?? null,\n  selected_document_ids: [document_id],\n  metadata: {\n    generated_by: 'n8n_document_worker',\n    job_id,\n    document_title: document.title,\n    evidence_count: chunks.length\n  }\n};\nconst healthSnapshots = (result.health_snapshots ?? [])\n  .filter((snapshot) => snapshot.snapshot_date !== null && snapshot.snapshot_date !== undefined)\n  .map((snapshot) => {\n    if (typeof snapshot.snapshot_date !== 'string' || !/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/.test(snapshot.snapshot_date)) {\n      throw new Error('The document worker returned an invalid evidenced health snapshot date.');\n    }\n    return {\n      project_id,\n      dimension: snapshot.dimension,\n      score: snapshot.score,\n      status: snapshot.status,\n      evidence_coverage: snapshot.evidence_coverage,\n      status_text: snapshot.status_text,\n      snapshot_date: snapshot.snapshot_date,\n      source_summary: snapshot.source_summary\n    };\n  });\nconst alerts = (result.alerts ?? []).map((alert) => ({\n  project_id,\n  severity: alert.severity,\n  impacted_area: alert.impacted_area,\n  explanation: alert.explanation,\n  evidence_count: alert.evidence_count,\n  recommended_action: alert.recommended_action,\n  source_path: '/app/projects/' + project_id + '/documents?document=' + document_id\n}));\nconst actions = (result.actions ?? []).map((action) => ({\n  project_id,\n  title: action.title,\n  owner_name: action.owner_name,\n  due_date: null,\n  priority: action.priority,\n  status: action.status,\n  source_path: '/app/projects/' + project_id + '/anomalies'\n}));\nconst anomalies = (result.anomalies ?? []).map((anomaly) => ({\n  project_id,\n  category: anomaly.category,\n  missing_field: anomaly.missing_field,\n  severity: anomaly.severity,\n  status: 'open',\n  title: anomaly.title,\n  affected_item: anomaly.affected_item,\n  explanation: anomaly.explanation,\n  impact: anomaly.impact,\n  impact_rating: anomaly.impact_rating,\n  recommended_action: anomaly.recommended_action,\n  suggested_owners: anomaly.suggested_owners,\n  evidence_count: anomaly.evidence_count,\n  absence_type: anomaly.absence_type,\n  rationale: anomaly.rationale,\n  source_path: '/app/projects/' + project_id + '/documents?document=' + document_id\n}));\n\nreturn [{\n  json: {\n    project_id,\n    document_id,\n    job_id,\n    document,\n    chunks,\n    extraction_run: {\n      project_id,\n      document_id,\n      ai_job_id: job_id,\n      status: 'processing',\n      metadata: {\n        source: 'n8n_document_processing',\n        worker: result.worker ?? 'external',\n        chunk_count: chunks.length,\n        fact_count: facts.length\n      }\n    },\n    facts,\n    fact_evidence: factEvidence,\n    summary,\n    health_snapshots: healthSnapshots,\n    alerts,\n    actions,\n    anomalies\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
