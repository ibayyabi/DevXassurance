      "id": "02cf216e-0abe-463e-962e-2489e76b16db",
      "name": "Insert Document Summary"
    },
    {
      "parameters": {
        "jsCode": "const rawSummary = $input.first().json;\nconst summary = Array.isArray(rawSummary) ? rawSummary[0] : rawSummary;\nconst rows = $items('Build Supabase Rows')[0].json;\nconst result = $items('Call Document Worker')[0].json;\nconst chunks = new Map($items('Upsert Document Chunks').map(item => [item.json.chunk_index, item.json]));\n\nif (!summary?.id) return [{ json: { sources: [] } }];\n\nconst sources = (result.summary_sources ?? []).map((source) => {\n  const chunk = chunks.get(source.evidence_chunk_index);\n  if (!chunk?.id || typeof source.excerpt !== 'string' || !source.excerpt || !chunk.chunk_text.includes(source.excerpt) || typeof source.confidence !== 'number' || !Number.isFinite(source.confidence) || source.confidence < 0 || source.confidence > 1) {\n    throw new Error('The document worker returned an invalid summary source citation.');\n  }\n  return {\n    project_id: rows.project_id,\n    summary_id: summary.id,\n    document_id: rows.document_id,\n    document_chunk_id: chunk.id,\n    excerpt: source.excerpt,\n    confidence: source.confidence\n  };\n});\nif (sources.length === 0) throw new Error('The document summary has no verified source citations.');\nreturn [{ json: { sources } }];"
      },
